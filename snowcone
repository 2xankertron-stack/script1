-- Function to auto-sell items
local function autoSellItems()
    -- Get the items to sell
    local itemsToSell = {
        ["Flavors"] = {AutoSellTextBox.Text},
    }

    -- Loop through each item to sell
    for item, playerNames in pairs(itemsToSell) do
        -- Get the player's character
        local character = Players:FindFirstChild(playerNames)

        -- If the player's character exists
        if character then
            -- Get the character's inventory
            local inventory = character:FindFirstChild("Inventory")

            -- If the inventory exists
            if inventory then
                -- Loop through each item in the inventory
                for _, item in pairs(inventory:GetChildren()) do
                    -- If the item is the item to sell
                    if item.Name == item then
                        -- Add the item to the inventory
                        item:Destroy()
                    end
                end

                -- If the item is not in the inventory
                if not inventory:FindFirstChild(item) then
                    -- Add the item to the inventory
                    local itemModel = require(game.ReplicatedStorage:WaitForChild("GamePass"):WaitForChild("ItemModels"):WaitForChild(item))
                    inventory:WaitForChild("Blueprints"):WaitForChild("RecipeBlueprints"):WaitForChild(item):WaitForChild("Recipe"):WaitForChild("Item"):Clone().Parent = inventory
                end
            end
        end
    end
end

-- Function to auto-buy items on a timer
local function autoBuyItemsTimer()
    -- Wait for the next second
    wait(1)

    -- Auto-buy items
    autoBuyItems()
end

-- Function to auto-blend items on a timer
local function autoBlendItemsTimer()
    -- Wait for the next second
    wait(1)

    -- Auto-blend items
    autoBlendItems()
end

-- Function to auto-sell items on a timer
local function autoSellItemsTimer()
    -- Wait for the next second
    wait(1)

    -- Auto-sell items
    autoSellItems()
end

-- Auto-buy items on a timer
while wait(1) do
    autoBuyItemsTimer()
    autoBlendItemsTimer()
    autoSellItemsTimer()
end

-- Auto-buy items when settings are updated
while wait() do
    -- Get the updated settings
    local updatedSettings = {
        ["AutoBuyFlavors"] = AutoBuyFlavorsTextBox.Text,
        ["AutoBuyMachines"] = AutoBuyMachinesTextBox.Text,
        ["AutoBuyTables"] = AutoBuyTablesTextBox.Text,
        ["AutoBuyTotems"] = AutoBuyTotemsTextBox.Text,
        ["AutoBuyPlants"] = AutoBuyPlantsTextBox.Text,
    }

    -- Loop through each updated setting
    for setting, value in pairs(updatedSettings) do
        -- If the setting's value is not empty
        if value ~= "" then
            -- Set the setting's value
            game.StarterPlayer.LocalPlayer.PlayerGui.SettingsFrame[setting.."Label"].Text = "Auto Buy " .. setting .. ": " .. value
        end
    end
end
